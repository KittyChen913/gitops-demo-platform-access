# Managed by gitops-demo-platform-access. BASE intentionally contains no endpoint records.
port=53
bind-dynamic
# 不使用 interface=：該 directive 以介面名比對且不分 address family，會讓 dnsmasq 連帶
# 監聽 lo 的 ::1 與 tunnel interface 的 IPv6 link-local，也把 binding 綁死在探測當下的
# 單一 as0tN。只保留 listen-address 時，iface_check 僅接受精確位址匹配，binding 收斂成
# 下列兩個 IPv4 address。
# except-interface 對目的地等於 listen-address 的封包不生效（dnsmasq 在位址匹配成立時
# 會跳過 except 清單），因此 public 的 fail-closed 由 listen-address 集合與 UFW 在 public
# interface 上的 DNS deny 規則負責，這個 directive 只是 defence-in-depth。
except-interface={{ openvpn_public_interface }}
listen-address=127.0.0.1
listen-address={{ internal_dns_server_ip }}
no-dhcp-interface=*
domain-needed
bogus-priv
no-resolv
{% for upstream_dns_server in upstream_dns_servers %}
server={{ upstream_dns_server }}
{% endfor %}
