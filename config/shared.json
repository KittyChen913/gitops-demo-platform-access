{
  "schema_version": 2,
  "repository": {
    "slug": "KittyChen913/gitops-demo-platform-access",
    "operations_ref": "refs/heads/master",
    "deployment_tag_prefix": "v"
  },
  "github": {
    "destroy_approval_environment": "shared-platform-access-destroy"
  },
  "aws": {
    "region": "ap-southeast-1",
    "oidc_role_name": "github-oidc-gitops-demo-platform-access-role",
    "destroy_oidc_role_name": "github-oidc-gitops-demo-platform-access-destroy-role",
    "ssm_parameter_paths": {
      "linode_token": "/gitops/shared/LINODE_TOKEN",
      "openvpn_contact_email": "/gitops/shared/OPENVPN_CONTACT_EMAIL",
      "openvpn_admin_password": "/gitops/platform-access/openvpn/ansible/OPENVPN_ADMIN_PASSWORD",
      "openvpn_ssh_private_key_b64": "/gitops/platform-access/openvpn/ansible/OPENVPN_SSH_PRIVATE_KEY_B64",
      "openvpn_ssh_public_key": "/gitops/platform-access/openvpn/ansible/OPENVPN_SSH_PUBLIC_KEY",
      "openvpn_ssh_host_key": "/gitops/platform-access/openvpn/ansible/OPENVPN_SSH_HOST_KEY",
      "vpn_public_egress_ip": "/gitops/platform-access/network/VPN_PUBLIC_EGRESS_IP",
      "vpn_client_cidr": "/gitops/platform-access/network/VPN_CLIENT_CIDR",
      "internal_dns_ip": "/gitops/platform-access/network/INTERNAL_DNS_IP"
    }
  },
  "linode": {
    "region": "ap-south",
    "instance_label": "openvpn-shared",
    "instance_type": "g6-standard-1",
    "image": "linode/ubuntu24.04",
    "marketplace_stackscript_id": 401719,
    "automation_username": "vpnadmin",
    "openvpn_admin_username": "openvpn",
    "openvpn_port": 1194,
    "openvpn_protocol": "udp",
    "admin_port": 943
  },
  "network": {
    "vpn_client_cidr": "172.27.224.0/20",
    "internal_dns_ip": "172.27.224.1",
    "upstream_dns_servers": ["1.1.1.1", "1.0.0.1"]
  },
  "credential_bootstrap": {
    "material_version": 1,
    "admin_password_length": 32
  },
  "terraform_backend": {
    "bucket": "kc-gitops-demo-tfstate",
    "key": "gitops-demo-platform-access/shared/base/terraform.tfstate",
    "encrypt": true,
    "use_lockfile": true
  },
  "credential_bootstrap_backend": {
    "bucket": "kc-gitops-demo-tfstate",
    "key": "gitops-demo-platform-access/shared/credential-bootstrap/terraform.tfstate",
    "encrypt": true,
    "use_lockfile": true
  }
}
